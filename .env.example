# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
DB_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# --- Ports / URLs -----------------------------------------------------------
FRONTEND_PORT=8088
DB_PORT=5433
CORS_ALLOWED_ORIGINS=http://localhost:8088
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- First admin account (created at startup if both are set) ---------------
NOTEMIND_ADMIN_EMAIL=
NOTEMIND_ADMIN_PASSWORD=

# --- Embeddings -------------------------------------------------------------
# transformers = local all-MiniLM-L6-v2 (384 dimensions, no API key).
# openai / ollama = remote. If you change the model, set the matching dimension
# BEFORE the first start; an existing database needs a new migration or reset.
NOTEMIND_EMBEDDING_PROVIDER=transformers
NOTEMIND_EMBEDDING_DIMENSION=384
# NOTEMIND_EMBEDDING_MODEL=text-embedding-3-small   # (1536 dimensions)

# --- Chat model -------------------------------------------------------------
# none = no LLM. NoteMind still retrieves and cites passages, but does not
# compose answers or generate quizzes.
# Options: openai | anthropic | ollama | none
NOTEMIND_CHAT_PROVIDER=none
# NOTEMIND_CHAT_MODEL=gpt-4o-mini

# OpenAI, or any OpenAI-compatible host:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# Groq:   OPENAI_BASE_URL=https://api.groq.com/openai
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#         OPENAI_COMPLETIONS_PATH=/chat/completions

# Anthropic:
# ANTHROPIC_API_KEY=

# Ollama (free, local): docker compose --profile ollama up -d
# OLLAMA_BASE_URL=http://ollama:11434

# --- Retrieval tuning -------------------------------------------------------
# 0.30 was chosen from evaluation/results.md for the default local model.
# Re-run the evaluation if you change the embedding model.
NOTEMIND_RAG_SIMILARITY_THRESHOLD=0.30
